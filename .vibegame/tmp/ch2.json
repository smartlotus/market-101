      "blocks": [
        {
          "type": "formula",
          "id": "settlement.formula",
          "label": "S 的计算",
          "expression": "S = clamp( 50 + rar × 833 , 0 , 100 ) − 40 × clamp( (maxDD − 0.05) / 0.15 , 0 , 1 ) − 15 × clamp( (costRatio − 0.002) / 0.010 , 0 , 1 )",
          "notes": [
            "章内调整收益 rar = (NAV₁ − I − NAV₀) / NAV₀",
            "章内最大回撤 maxDD = max_t ( (峰值调整NAV − 调整NAV_t) / 峰值调整NAV )",
            "章内成本比 costRatio = 章内累计交易费用 / 章内累计成交金额",
            "黄档（NAV < ¥50,000）时：成本罚分项 ×0.5"
