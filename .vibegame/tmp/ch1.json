  "choices": {
    "1.9.confirm": {
      "id": "1.9.confirm",
      "question": "你昨天买的那 100 股，今天能不能卖？为什么？",
      "conceptKey": "T+1",
      "correctKey": "t1",
      "options": [
        {
          "key": "t1",
          "text": "能卖。A 股买入的股票，要到下一个交易日才能卖，今天已经是下一个交易日了。",
          "feedback": "对。你昨天买的，今天才可卖——这条规则叫 T+1。它能卖不是因为今天涨了，是因为交易日换了。"
        },
        {
          "key": "limit",
          "text": "不能卖。它今天要是涨到涨停价，涨停的股票就不能卖。",
          "feedback": "我们再摆一次：能不能卖，与今天涨没涨、有没有涨停无关。A 股买入的股票要等到下一个交易日才能卖，这条规则叫 T+1。"
        }
      ]
    }
  },
